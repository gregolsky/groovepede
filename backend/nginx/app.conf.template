# Rendered from this template at container start by the nginx image's
# docker-entrypoint (envsubst). Only ${DOMAIN}, ${RATE_LIMIT}, ${RATE_LIMIT_BURST}
# are env vars — nginx runtime vars ($host, $remote_addr, …) are left untouched.

# Per-IP rate limiting — replaces AWS WAF's rate-based rule.
limit_req_zone $binary_remote_addr zone=gp_rl:10m rate=${RATE_LIMIT};
# Own, much stricter zone for the client error beacon (/v1/log below) — a
# diagnostic sink has no business sharing the main API's rate budget, in
# either direction: a chatty beacon shouldn't crowd out real requests, and a
# burst of real traffic shouldn't cost the beacon its budget either.
limit_req_zone $binary_remote_addr zone=gp_log:10m rate=6r/m;

# This template renders into conf.d/, which the stock image includes from inside
# the http block — where nginx.conf has ALREADY declared
#   access_log /var/log/nginx/access.log main;
# Directives declared at the same level are cumulative (all of them fire), so
# adding a SECOND access_log pointing at that same file here previously wrote
# every request to it twice — fail2ban then counted each 404 twice and banned
# at half the configured maxretry. The fix then was to add none at all, which
# is why the only access log lived in the bind-mounted file fail2ban tails
# (docker-compose.yml maps ./data/nginx-logs over /var/log/nginx, shadowing
# the image's stdout symlink) — `docker compose logs nginx` showed nothing.
#
# Adding exactly ONE more destination (stdout) is safe: it's cumulative with
# nginx.conf's file directive, not a replacement of it, so the file still
# gets written exactly once — only stdout is new. If you ever need to touch
# the file destination itself, do it in nginx.conf, not by adding another
# access_log here.
access_log /dev/stdout main;

# ── AI / LLM training crawlers ──────────────────────────────────────────────
# Matched on User-Agent and dropped with 444 (close connection, no response) —
# cheaper than 403 and gives fail2ban a distinct status code to filter on.
#
# Honest caveat: User-Agent is trivially spoofable, so this only stops crawlers
# that self-identify. It does nothing about the l9scan/leakix-style scanners in
# the logs, which don't announce themselves — that's what fail2ban is for.
map $http_user_agent $gp_blocked_bot {
    default                 0;
    "~*GPTBot"              1;
    "~*ChatGPT-User"        1;
    "~*OAI-SearchBot"       1;
    "~*ClaudeBot"           1;
    "~*Claude-Web"          1;
    "~*anthropic-ai"        1;
    "~*CCBot"               1;
    "~*Bytespider"          1;
    "~*Google-Extended"     1;
    "~*Amazonbot"           1;
    "~*PerplexityBot"       1;
    "~*Applebot-Extended"   1;
    "~*cohere-ai"           1;
    "~*Diffbot"             1;
    "~*ImagesiftBot"        1;
    "~*Omgilibot"           1;
    "~*FacebookBot"         1;
    "~*Meta-ExternalAgent"  1;
}

# ── HTTP :80 — ACME HTTP-01 challenge + redirect to HTTPS ───────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt webroot challenge (served by certbot's shared volume).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS :443 — TLS termination + proxy to the resolver ────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Resolve the resolver's hostname at REQUEST time via Docker's embedded
    # DNS, not once at config-load time. A bare `proxy_pass http://resolver:…`
    # fails config parsing outright ("host not found in upstream") if the
    # resolver container's network isn't up yet at the moment nginx starts —
    # which turned a brief Docker networking hiccup into hours of downtime,
    # since nginx then refuses to start at all and just restart-loops forever.
    # A $variable in proxy_pass defers resolution to request time and
    # re-resolves per the `valid=` TTL, so nginx starts regardless and a dead
    # upstream degrades to a 502 that self-heals instead of never starting.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $gp_upstream resolver;

    # Unauthenticated liveness check (no rate limit).
    location = /healthz {
        proxy_pass http://$gp_upstream:8787/healthz;
    }

    # Client error beacon — deliberately its own exact-match location (nginx
    # picks the most specific match, so this wins over `location /` below
    # regardless of declaration order) with its own strict rate zone. Without
    # this it would share gp_rl's budget with the real API in both
    # directions: a chatty beacon crowding out real requests, or a burst of
    # real traffic costing the beacon its own room to report failures.
    location = /v1/log {
        if ($gp_blocked_bot) { return 444; }

        limit_req zone=gp_log burst=3 nodelay;
        limit_req_status 429;
        # Body is capped server-side too (LOG_MAX_BODY_BYTES in
        # resolver-core.mjs) — this is the earlier, cheaper rejection.
        client_max_body_size 8k;

        proxy_pass http://$gp_upstream:8787$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header Origin            $http_origin;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 5s;
    }

    location / {
        # Drop self-identifying AI crawlers before any proxying happens.
        # Deliberately NOT in the :80 server — that block must keep serving
        # /.well-known/acme-challenge/ unconditionally or renewal breaks.
        if ($gp_blocked_bot) { return 444; }

        limit_req zone=gp_rl burst=${RATE_LIMIT_BURST} nodelay;
        limit_req_status 429;

        # $request_uri is required here: with a variable in proxy_pass (as
        # opposed to a plain URL), nginx no longer appends the matched URI
        # automatically, so it must be added back explicitly.
        proxy_pass http://$gp_upstream:8787$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header Origin            $http_origin;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # /v1/album fetches the pasted album page itself (8s budget, AbortSignal-
        # bounded) and then up to two cross-linking lookups in parallel (8s each)
        # — worst case ~16s end to end. 10s was fine for the old Odesli-only
        # proxy but would cut that off mid-request, so this is comfortably above it.
        proxy_read_timeout 25s;
    }
}
