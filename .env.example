# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and never committed.
#
# For CI (GitHub Actions), add VITE_GP_PRIVATE_KEY as a repository secret and
# expose it in the build step:
#
#   - name: Build
#     run: npm run build
#     env:
#       VITE_GP_PRIVATE_KEY: ${{ secrets.VITE_GP_PRIVATE_KEY }}
#
# Generate the key pair (one-time):
#   cd infra/resolver && make keygen
# This prints VITE_GP_PRIVATE_KEY (for here / CI secret) and GP_PUBLIC_KEY
# (set as GP_PUBLIC_KEY in the resolver's own .env — see infra/resolver/.env.example).

# ECDSA-P256 private key, PKCS8 DER format, base64-encoded.
# Used by the browser to sign each x-gp-token request header.
# The resolver verifies using the matching GP_PUBLIC_KEY.
VITE_GP_PRIVATE_KEY=
