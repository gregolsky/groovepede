{
  "id": "/",
  "name": "Groovepede",
  "short_name": "Groovepede",
  "description": "A minimalist, local-first PWA for queuing albums from Spotify, Apple Music, YouTube Music, Tidal, Deezer and Pandora. No account needed — save recommendations, browse by genre, and check them off as you listen.",
