# Copy to .env and fill in.  .env is git-ignored.

# Public hostname for the Pi resolver — a NEW DNS A record pointing at your
# home public IP. MUST differ from api.groovepede.gregolsky.pl (that's the AWS
# CloudFront edge). e.g. a subdomain you control:
DOMAIN=pi.example.com

# Email for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=you@example.com

# ECDSA-P256 public key (SPKI DER, base64) — the SAME key pair as the AWS Lambda,
# so the PWA's existing signed tokens verify here too.
# Get it from:  cd ../resolver && make keygen   (copy the GP_PUBLIC_KEY value)
GP_PUBLIC_KEY=

# Optional Odesli API key (blank = free keyless tier).
ODESLI_KEY=

# nginx per-IP rate limit (replaces AWS WAF's rate rule).
RATE_LIMIT=10r/s
RATE_LIMIT_BURST=20

# Host ports to publish (nginx still listens on 80/443 inside the container).
# Defaults are 80/443. Use high ports (e.g. 8080/4433) to avoid needing root or
# to dodge a conflict — but your router must then forward public 80 → HTTP_PORT
# and 443 → HTTPS_PORT, because Let's Encrypt HTTP-01 validates on public :80 and
# browsers expect :443.
HTTP_PORT=80
HTTPS_PORT=443

# Optional: extra allowed CORS origins (comma-separated), added to the built-in
# defaults (https://groovepede.gregolsky.pl, http://localhost:5173).
ALLOWED_ORIGINS=

# uid:gid the containers run as. All three (resolver/nginx/certbot) share one
# id so ownership of ./data agrees. Keep it above 10000: Debian/Raspberry Pi OS
# allocate system accounts dynamically up to 999, so a low id can collide with
# a real host account (999 is systemd-coredump on many machines).
PUID=10001
PGID=10001
