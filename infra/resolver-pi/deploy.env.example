# Copy to deploy.env and fill in.  deploy.env is git-ignored and is NOT copied
# to the Pi — it only configures deploy.sh (where to deploy).
#
#   cp deploy.env.example deploy.env
#   ./deploy.sh

# SSH target for the Raspberry Pi (user@host or an ssh_config alias).
PI_SSH_TARGET=gregolsky@192.168.1.123

# Remote directory on the Pi (relative to the login home, i.e. ~/groovepede-resolver).
PI_REMOTE_DIR=groovepede-resolver
